{
  "name": "sobrou",
  "private": true,
  "version": "0.1.0",
  "description": "Sobrou — controle financeiro e rentabilidade para motoristas de aplicativo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace @sobrou/finance",
    "test:watch": "npm run test:watch --workspace @sobrou/finance",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace @sobrou/web",
    "build": "npm run build --workspace @sobrou/web"
  },
  "engines": {
    "node": ">=20"
  }
}
